# Configuración Servidor TCP
TCP_HOST=0.0.0.0
TCP_PORT=5001
MAX_CONNECTIONS=100
SOCKET_TIMEOUT=30.0
SERVER_ID=server-node-a

# Configuración RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_TASKS=task_queue
RABBITMQ_QUEUE_RESULTS=results_queue

# Configuración PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=distributed_tasks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Configuración S3 / MinIO (Opcional / Artefactos)
S3_ENABLED=true
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=task-artifacts
S3_REGION=us-east-1

# Configuración Worker
WORKER_ID=worker-01
WORKER_THREADS=4
WORKER_PREFETCH=1
